[sub_resource type="GDScript" id="GDScript_a8y0u"]
script/source = "extends RichTextLabel

const VERSION = \"0.1.1\"
@onready var version_label: Label = $\"../HBoxContainer/VersionLabel\"

var ABOUT_MSG = \"\\
[img=24]res://ui/icons/other/github.png[/img] \\
[url=https://github.com/BaconEggsRL/procedural-animation]GitHub[/url] \\
| [img=24]res://ui/icons/other/kofi_cup.webp[/img] \\
[url=https://ko-fi.com/baconeggsrl]KoFi[/url]\"

func _ready() -> void:
	# Connect the signal via code (or use the Node tab in the editor)
	meta_clicked.connect(_on_meta_clicked)
	self.text = ABOUT_MSG
	version_label.text = VERSION

func _on_meta_clicked(meta: Variant) -> void:
	var meta_string = str(meta)

	# Scenario A: If it's a web URL, open it in the user's browser
	if meta_string.begins_with(\"http://\") or meta_string.begins_with(\"https://\"):
		OS.shell_open(meta_string)
"

